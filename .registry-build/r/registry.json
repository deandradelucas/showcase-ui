{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "showcase-ui",
  "homepage": "https://github.com/deandradelucas/showcase-ui",
  "items": [
    {
      "name": "mode-toggle",
      "type": "registry:ui",
      "title": "Mode Toggle",
      "description": "Dropdown de tema claro/escuro/sistema via next-themes.",
      "dependencies": ["next-themes"],
      "registryDependencies": ["button", "dropdown-menu"],
      "files": [
        {
          "path": "components/mode-toggle.tsx",
          "type": "registry:ui",
          "target": "components/mode-toggle.tsx"
        }
      ]
    },
    {
      "name": "app-sidebar",
      "type": "registry:ui",
      "title": "App Sidebar",
      "description": "Sidebar de navegação com item ativo via usePathname e o mode-toggle no rodapé.",
      "dependencies": ["next-themes"],
      "registryDependencies": ["sidebar", "button", "dropdown-menu"],
      "files": [
        {
          "path": "components/app-sidebar.tsx",
          "type": "registry:ui",
          "target": "components/app-sidebar.tsx"
        },
        {
          "path": "components/mode-toggle.tsx",
          "type": "registry:ui",
          "target": "components/mode-toggle.tsx"
        }
      ]
    }
  ]
}
